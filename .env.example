APP_URL=https://tico.example

ROMM_URL=http://romm.example
ROMM_API_TOKEN=rmm_API_TOKEN

INSTANCE_SLUG=home

SYNC_INTERVAL_MINUTES=60

LIBRARY_PATH=/data/library
CONFIG_PATH=/data/config
CACHE_PATH=/data/cache
CACHE_MAX_GB=50

# FAT32 cannot write files over 4GB
SKIP_FILES_OVER_4GIB=true

# User and group the bridge runs as inside the container.
# They must be able to read the library and write the config and cache folders.
PUID=1000
PGID=1000