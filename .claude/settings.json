{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(uv lock --check)",
      "Bash(docker compose build)",
      "Bash(docker compose build *)",
      "Bash(docker compose config)",
      "Bash(docker compose config *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(docker compose down *)",
      "Bash(docker compose up *)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  }
}
